# Kan vel brukast for stadar som ikkje nødvendigvis er byar (og iallfall for det me vil kalla tettstadar på norsk).
#: weathertoolplugin.cpp:21
msgid "The name of the city"
msgstr "Namnet på staden"

#: weathertoolplugin.cpp:27
msgid "The information that we need"
msgstr "Informasjonen me treng"

#: weathertoolplugin.cpp:47
#, kde-format
msgid "Ask Weather Report"
msgstr "Spør vêrmeldinga"

#: weathertoolplugin.cpp:52
#, kde-format
msgid "Use this tool to get the current weather for a city"
msgstr "Bruk dette verktøyet for å henta vêrmelding for ein stad"

#: weathertoolplugindialog.cpp:16
#, kde-format
msgid "Configure Weather Tool Plugin"
msgstr "Set opp programtillegg for vêrmelding"

#: weathertoolpluginjob.cpp:29
#, kde-format
msgid "Get Current Weather."
msgstr "Hent vêrmelding."

#: weathertoolpluginjob.cpp:49
#, kde-format
msgid "No city found."
msgstr "Fann ingen stad."

#: weathertoolpluginjob.cpp:99
#, kde-format
msgid "The weather is %1"
msgstr "Vêret er %1"

#: weathertoolpluginjob.cpp:102
#, kde-format
msgid "The temperature will be between %1°C and %2°C."
msgstr "Temperaturen vil vera mellom %1 °C og %2 °C."

#: weathertoolpluginjob.cpp:105
#, kde-format
msgid "The humidity is %1"
msgstr "Luftafukta er %1"

#: weathertoolpluginjob.cpp:108
#, kde-format
msgid "The pressure is %1"
msgstr "Lufttrykket er %1"

#: weathertoolpluginjob.cpp:111
#, kde-format
msgid "The uv index is %1"
msgstr "UV-indeksen er %1"
